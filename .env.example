# Copy to `.env` and fill in. `.env` is gitignored - never commit it.
# In production use: wrangler secret put GITHUB_TOKEN

# GitHub token (classic works, no scopes needed for public data).
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: extra tokens (comma-separated) to spread requests across for higher limits.
# GITHUB_TOKENS=token1,token2

# Optional: usernames to refuse, comma-separated.
# BLOCKLIST=someuser,anotheruser

# Optional: Spotify "now playing" card for your own account (see README > Spotify setup).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
